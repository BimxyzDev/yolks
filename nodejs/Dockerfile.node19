FROM debian:bookworm-slim

ARG TARGETARCH
ARG NODE_VERSION=19.9.0
ARG CLOUDFLARED_VERSION=latest

LABEL org.opencontainers.image.source="https://github.com/BimxyzDev/yolks"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils git jq ffmpeg iproute2 dnsutils iputils-ping \
      sqlite3 libsqlite3-dev python3 python3-dev build-essential libtool \
      tzdata zip unzip tar tini fonts-liberation chromium \
 && case "${TARGETARCH}" in \
      amd64) NODE_ARCH=x64 ;; \
      arm64) NODE_ARCH=arm64 ;; \
      *) echo "Unsupported arch: ${TARGETARCH}"; exit 1 ;; \
    esac \
 && NODE_TAR="node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
 && curl --fail --location --silent --show-error -O "https://nodejs.org/dist/v${NODE_VERSION}/${NODE_TAR}" \
 && curl --fail --location --silent --show-error "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" | grep " ${NODE_TAR}" | sha256sum -c - \
 && tar -xJf "${NODE_TAR}" -C /usr/local --strip-components=1 --no-same-owner \
 && rm -f "${NODE_TAR}" \
 && ln -sf /usr/local/bin/node /usr/local/bin/nodejs \
 && node --version \
 && npm --version \
 && if [ "${CLOUDFLARED_VERSION}" = "latest" ]; then \
      CF_URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${TARGETARCH}"; \
    else \
      CF_URL="https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-${TARGETARCH}"; \
    fi \
 && curl --fail --location --silent --show-error "${CF_URL}" -o /usr/local/bin/cloudflared \
 && chmod 755 /usr/local/bin/cloudflared \
 && cloudflared --version \
 && useradd -m -d /home/container -s /bin/bash container \
 && rm -rf /var/lib/apt/lists/*

USER container
ENV USER=container \
    HOME=/home/container \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /home/container

COPY --chmod=755 entrypoint.sh /entrypoint.sh
COPY --chmod=755 start.sh /usr/local/bin/start.sh

ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["/bin/bash", "/entrypoint.sh"]
